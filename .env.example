# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/openjournal
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI APIs
# Provider: auto | ollama | huggingface | openai
AI_PROVIDER=auto
HF_TOKEN=your-huggingface-token
HF_PROVIDER=hf-inference

# Hugging Face task models
HF_INTENT_MODEL=microsoft/deberta-v3-large
HF_EMBED_MODEL=BAAI/bge-large-en-v1.5
HF_RERANK_MODEL=BAAI/bge-reranker-large
HF_CHAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_CHAT_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_RERANK_FALLBACK_MODEL=BAAI/bge-reranker-base
HF_ASR_MODEL=openai/whisper-large-v3
HF_ASR_PROVIDER=hf-inference

# OpenAI fallback (optional)
OPENAI_API_KEY=your-openai-api-key

# Localhost Ollama (kept for development/testing)
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=qwen2.5:7b

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=https://openjournal.me,https://www.openjournal.me
